{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "um-contact-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The relay URL is public, so this caps spam reaching Slack. Cloudflare counts per location, so the cap is approximate.
  "unsafe": {
    "bindings": [
      {
        "name": "LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 },
      },
    ],
  },
}
